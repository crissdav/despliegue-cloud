# Copia este archivo como .env y completa los valores:   cp .env.example .env
# NUNCA subas el archivo .env a git (ya está en .gitignore).

# --- Base de datos (RDS) ---
# Endpoint de RDS: Consola > RDS > Databases > tu base > "Connectivity & security" > Endpoint
DB_HOST=diario-db.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=CambiaEstaClave123
DB_NAME=diario
# true = conexión cifrada (TLS) con los certificados de Amazon RDS
DB_SSL=false

# --- Protección del diario (opcional) ---
# Si defines APP_PASSWORD, el navegador pedirá usuario/contraseña.
APP_USER=admin
APP_PASSWORD=
