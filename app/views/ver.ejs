<%- include('partials/cabecera', { tituloPagina: entrada.titulo, volver: '/' }) %>

<article class="lectura animo-<%= entrada.animo %>">
  <header class="lectura-cabecera">
    <p class="lectura-meta">
      <span class="etiqueta-animo"><%- icono(entrada.animo) %><%= ANIMOS[entrada.animo] %></span>
      <time datetime="<%= entrada.fecha %>"><%= fecha.larga(entrada.fecha) %></time>
    </p>
    <h1 class="lectura-titulo"><%= entrada.titulo %></h1>
  </header>

  <div class="lectura-texto"><%= entrada.contenido %></div>

  <p class="lectura-nota">
    Escrita el <%= fecha.momento(entrada.creado_en) %><% if (entrada.actualizado_en !== entrada.creado_en) { %>
    · editada el <%= fecha.momento(entrada.actualizado_en) %><% } %>
  </p>
</article>

<div class="acciones">
  <a class="boton boton-secundario" href="/entradas/<%= entrada.id %>/editar"><%- icono('editar') %>Editar</a>
  <form method="post" action="/entradas/<%= entrada.id %>/eliminar"
        onsubmit="return confirm('¿Eliminar «<%= entrada.titulo.replace(/['\\]/g, '') %>»? Esta acción no se puede deshacer.')">
    <button type="submit" class="boton boton-peligro"><%- icono('borrar') %>Eliminar</button>
  </form>
</div>

<%- include('partials/pie') %>
