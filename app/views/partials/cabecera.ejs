<%
  // Parámetros opcionales: tituloPagina, volver (URL del botón atrás), ocultarNueva
  const _titulo = typeof tituloPagina !== 'undefined' ? tituloPagina : '';
  const _volver = typeof volver !== 'undefined' ? volver : null;
  const _ocultarNueva = typeof ocultarNueva !== 'undefined' && ocultarNueva;
%><!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#f6f1e8" media="(prefers-color-scheme: light)">
  <meta name="theme-color" content="#16130f" media="(prefers-color-scheme: dark)">
  <title><%= _titulo ? _titulo + ' · ' : '' %>Mi diario</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;1,6..72,400&display=swap">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <%- include('iconos') %>
  <a class="saltar" href="#contenido">Saltar al contenido</a>
  <header class="barra">
    <div class="barra-interior">
      <% if (_volver) { %>
        <a class="boton-icono" href="<%= _volver %>" aria-label="Volver"><%- icono('atras') %></a>
      <% } %>
      <a class="marca" href="/">Mi diario</a>
      <% if (!_ocultarNueva) { %>
        <a class="boton boton-primario solo-escritorio" href="/entradas/nueva"><%- icono('mas') %>Nueva entrada</a>
      <% } %>
    </div>
  </header>
  <main id="contenido" class="contenedor">
