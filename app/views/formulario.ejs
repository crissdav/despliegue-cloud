<% const cancelar = entrada.id ? '/entradas/' + entrada.id : '/'; %>
<%- include('partials/cabecera', { tituloPagina: titulo, volver: cancelar, ocultarNueva: true }) %>

<h1 class="pagina-titulo"><%= titulo %></h1>

<% if (errores.length) { %>
  <div class="aviso aviso-error" role="alert">
    <%- icono('alerta') %>
    <div>
      <p><strong>Revisa estos campos antes de guardar:</strong></p>
      <ul><% errores.forEach((e) => { %><li><%= e %></li><% }) %></ul>
    </div>
  </div>
<% } %>

<form class="formulario" method="post" action="<%= accion %>">
  <div class="campo campo-fecha">
    <label for="fecha">Fecha</label>
    <input id="fecha" type="date" name="fecha" value="<%= entrada.fecha %>" required>
  </div>

  <fieldset class="campo">
    <legend>¿Cómo te sentiste?</legend>
    <div class="selector-animo">
      <% Object.entries(ANIMOS).forEach(([clave, texto]) => { %>
        <label class="opcion-animo animo-<%= clave %>">
          <input type="radio" name="animo" value="<%= clave %>" <%= entrada.animo === clave ? 'checked' : '' %> required>
          <%- icono(clave) %>
          <span><%= texto %></span>
        </label>
      <% }) %>
    </div>
  </fieldset>

  <div class="campo">
    <label for="titulo">Título</label>
    <input id="titulo" type="text" name="titulo" value="<%= entrada.titulo %>" maxlength="150" required
           placeholder="Un resumen del día en pocas palabras" autocomplete="off" enterkeyhint="next">
  </div>

  <div class="campo">
    <label for="contenido">¿Qué pasó hoy?</label>
    <textarea id="contenido" name="contenido" rows="8" required
              placeholder="Escribe con calma. Nadie más lo va a leer."><%= entrada.contenido %></textarea>
  </div>

  <div class="barra-guardar">
    <a class="boton boton-fantasma" href="<%= cancelar %>">Cancelar</a>
    <button type="submit" class="boton boton-primario">Guardar entrada</button>
  </div>
</form>

<%- include('partials/pie') %>
