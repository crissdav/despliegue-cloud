<%- include('partials/cabecera', { tituloPagina: 'Inicio' }) %>

<%
  const enlace = (a) => {
    const p = new URLSearchParams();
    if (q) p.set('q', q);
    if (a) p.set('animo', a);
    const s = p.toString();
    return s ? `/?${s}` : '/';
  };
  const filtrando = Boolean(q || animo);
%>

<section class="herramientas" aria-label="Buscar y filtrar">
  <form class="buscador" method="get" action="/" role="search">
    <%- icono('buscar', 'buscador-icono') %>
    <label class="sr-only" for="q">Buscar en el diario</label>
    <input id="q" type="search" name="q" value="<%= q %>" placeholder="Buscar en el diario" autocomplete="off" enterkeyhint="search">
    <% if (animo) { %><input type="hidden" name="animo" value="<%= animo %>"><% } %>
    <button class="sr-only" type="submit">Buscar</button>
  </form>

  <% if (total) { %>
    <nav class="filtro-animo" aria-label="Filtrar por ánimo">
      <a class="chip" href="<%= enlace('') %>" <%- !animo ? 'aria-current="true"' : '' %>>
        Todas <span class="chip-num"><%= total %></span>
      </a>
      <% Object.entries(ANIMOS).forEach(([clave, texto]) => {
           if (!conteo[clave] && animo !== clave) return; %>
        <a class="chip animo-<%= clave %>" href="<%= enlace(clave) %>" <%- animo === clave ? 'aria-current="true"' : '' %>>
          <%- icono(clave, 'chip-icono') %><%= texto %> <span class="chip-num"><%= conteo[clave] || 0 %></span>
        </a>
      <% }) %>
    </nav>
  <% } %>
</section>

<% if (filtrando) { %>
  <p class="estado-filtro">
    <%= entradas.length %> <%= entradas.length === 1 ? 'entrada' : 'entradas' %>
    <% if (q) { %>con «<%= q %>»<% } %>
    <% if (animo) { %>· <%= ANIMOS[animo].toLowerCase() %><% } %>
    <a href="/">Quitar filtros</a>
  </p>
<% } %>

<% if (!entradas.length) { %>
  <div class="vacio">
    <%- icono('pluma', 'vacio-icono') %>
    <% if (filtrando) { %>
      <h1>Nada por aquí</h1>
      <p>Ninguna entrada coincide con la búsqueda.</p>
      <a class="boton boton-secundario" href="/">Ver todas las entradas</a>
    <% } else { %>
      <h1>Tu diario está en blanco</h1>
      <p>Escribe cómo te fue hoy. Solo tú lo vas a leer.</p>
      <a class="boton boton-primario" href="/entradas/nueva"><%- icono('mas') %>Escribir la primera entrada</a>
    <% } %>
  </div>
<% } else { %>
  <h1 class="sr-only">Entradas del diario</h1>
  <% let mesActual = null; %>
  <% entradas.forEach((e, i) => {
       const mes = fecha.mes(e.fecha);
       if (mes !== mesActual) {
         if (mesActual !== null) { %></ol></section><% }
         mesActual = mes; %>
    <section class="mes" aria-label="<%= mes %>">
      <h2 class="mes-titulo"><%= mes %></h2>
      <ol class="entradas">
  <%   } %>
        <li class="fila animo-<%= e.animo %>">
          <a href="/entradas/<%= e.id %>">
            <time class="fila-fecha" datetime="<%= e.fecha %>">
              <span class="fila-dia"><%= fecha.dia(e.fecha) %></span>
              <span class="fila-semana"><%= fecha.semana(e.fecha) %></span>
            </time>
            <span class="fila-cuerpo">
              <span class="fila-titulo"><%= e.titulo %></span>
              <span class="fila-resumen"><%= e.resumen %></span>
            </span>
            <span class="fila-animo" title="<%= ANIMOS[e.animo] %>">
              <%- icono(e.animo) %><span class="sr-only"><%= ANIMOS[e.animo] %></span>
            </span>
          </a>
        </li>
  <% }) %>
      </ol>
    </section>
<% } %>

<%- include('partials/pie', { fab: true }) %>
