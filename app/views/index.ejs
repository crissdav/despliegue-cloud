<%- include('partials/cabecera', { tituloPagina: 'Inicio' }) %>

<form class="filtros" method="get" action="/">
  <input type="search" name="q" value="<%= q %>" placeholder="Buscar en el diario…">
  <select name="animo">
    <option value="">Todos los ánimos</option>
    <% Object.entries(ANIMOS).forEach(([clave, texto]) => { %>
      <option value="<%= clave %>" <%= animo === clave ? 'selected' : '' %>><%= texto %></option>
    <% }) %>
  </select>
  <button type="submit">Filtrar</button>
  <% if (q || animo) { %><a href="/">Limpiar</a><% } %>
</form>

<% if (resumen.length) { %>
  <section class="resumen">
    <% resumen.forEach((r) => { %>
      <a class="chip animo-<%= r.animo %>" href="/?animo=<%= r.animo %>"><%= ANIMOS[r.animo] %> · <%= r.total %></a>
    <% }) %>
  </section>
<% } %>

<% if (!entradas.length) { %>
  <div class="vacio">
    <p><%= q || animo ? 'No hay entradas que coincidan con el filtro.' : 'Tu diario está vacío.' %></p>
    <a class="boton" href="/entradas/nueva">Escribir la primera entrada</a>
  </div>
<% } else { %>
  <ul class="lista">
    <% entradas.forEach((e) => { %>
      <li class="tarjeta animo-<%= e.animo %>">
        <a href="/entradas/<%= e.id %>">
          <div class="meta">
            <time datetime="<%= e.fecha %>"><%= e.fecha %></time>
            <span><%= ANIMOS[e.animo] %></span>
          </div>
          <h2><%= e.titulo %></h2>
          <p><%= e.resumen %><%= e.resumen.length >= 200 ? '…' : '' %></p>
        </a>
      </li>
    <% }) %>
  </ul>
<% } %>

<%- include('partials/pie') %>
